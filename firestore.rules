rules_version = '2';

/* 打卡日記 · Firestore 安全規則
   每個人只能讀寫自己 users/{uid} 底下的資料,其他一律拒絕。
   到 Firebase 主控台 → Firestore Database → 規則 → 貼上 → 發布 */

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // 設定
      match /meta/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // 舊版單一工作的每日打卡(保留讀寫,升級後仍留著當備份)
      match /days/{dateId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null
                     && request.auth.uid == userId
                     && dateId.matches('^\\d{4}-\\d{2}-\\d{2}$');
      }

      // 多份工作 / 多雇主
      match /jobs/{jobId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        match /days/{dateId} {
          allow read: if request.auth != null && request.auth.uid == userId;
          allow write: if request.auth != null
                       && request.auth.uid == userId
                       && dateId.matches('^\\d{4}-\\d{2}-\\d{2}$');
        }

        // 薪資對帳:每期實際入帳金額
        match /recon/{periodId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }

    // 帳號(自訂使用者名稱)→ email 對應表
    // 登入 / 忘記密碼時需要在「還沒登入」的狀態下查詢,所以開放公開讀取。
    // 內容只有 uid 和 email,不含密碼,建立後不可更改或刪除,避免帳號被搶佔。
    match /usernames/{usernameId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
